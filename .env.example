# Load through your process manager or export explicitly; no dotenv dependency.
PRINT_PUBLIC_HOST=print.example.com
PRINT_QUEUE=printer
# Optional ESC/POS raw queue; omit to keep print_receipt unregistered.
# PRINT_RECEIPT_QUEUE=receipt
# PRINT_RECEIPT_COLUMNS=48
PRINT_CUPS_SERVER=localhost:631
PRINT_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf
# Set both for Cloudflare Access; omit both only for trusted localhost use.
ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
ACCESS_AUD=replace-with-application-audience
